    "@types/supertest": "^6.0.3",
    "prisma": "^7.0.0",
    "@types/passport-jwt": "^4.0.1",
    "dotenv": "^17.0.0",
    "tsx": "^4.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3"
