PORT=3000

# Carpeta local de imágenes, relativa al directorio de ejecución del backend.
# Montar esta carpeta como volumen persistente al implementar Docker de la Fase 14.
UPLOADS_DIR=uploads

# Generar un secreto aleatorio de al menos 32 bytes en .env, sin valor predeterminado.
JWT_SECRET=
# Duración del token en segundos, de 1 a 86400 (por defecto: 900).
JWT_EXPIRES_IN=900

# Completar en .env; nunca guardar credenciales reales en Git.
DATABASE_URL="postgresql://books:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/books?schema=public"

# Solo para PostgreSQL de desarrollo con Docker Compose.
POSTGRES_USER=books
POSTGRES_DB=books
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Seed de desarrollo: elegir una contraseña de 12 caracteres o más (máximo 72 bytes).
NODE_ENV=development
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=
