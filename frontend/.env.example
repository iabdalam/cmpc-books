# Ruta de API del navegador; Vite reenvía /api al backend durante desarrollo/preview.
VITE_API_BASE_URL=/api
# Configuración solo del servidor Vite, no se incorpora al bundle del navegador.
API_PROXY_TARGET=http://127.0.0.1:3000
# Docker usa Nginx: /api se reenvía a backend:3000 y las rutas SPA sirven index.html.
# API_PROXY_TARGET solo aplica a Vite; la imagen utiliza /api sin secretos de build.
